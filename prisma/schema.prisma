datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  gender       String // ENUM in MySQL, validated by Zod
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  role         String   @default("user") // ENUM in MySQL
  createdAt    DateTime @default(now())

  // user-selected onboarding categories (eg. ["educational","language"]) stored as JSON
  categories          Json?
  // user preferences
  mood                String? // single mood (e.g. "آرام")
  Motivation          Json?   // array of motivations (e.g. ["یادگیری"]) 
  Age                 String? // age group string (e.g. "۱۸–۲۵")
  author              Json? // Int[]
  book_length         Json? // Length[]
  recommendedBooksIds Json? // Int[]

  // Relations
  favorites       Favorite[]
  readingProgress Reading_Progress[]
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category?  @relation("SubCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("SubCategory")
  books    Book[]
}

model Book {
  id           Int       @id @default(autoincrement())
  title        String
  description  String    @db.Text
  authorId     Int
  publish_date DateTime?
  pdfURL       String?
  coverURL     String?

  // JSON fields
  mood       Json? // Mood[]
  Motivation Json? // MotivationType[]

  // Single enums stored as strings
  Age    String? // ENUM
  length Int?

  // Category relation (replaces old category String field)
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Relations
  author      Author             @relation(fields: [authorId], references: [id])
  favoritedBy Favorite[]
  readBy      Reading_Progress[]

  @@index([publish_date])
}

model Favorite {
  id     Int @id @default(autoincrement())
  userId Int
  bookId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId]) // Prevent duplicate favorites
}

model Reading_Progress {
  id        Int      @id @default(autoincrement())
  userId    Int
  bookId    Int
  lastPage  Int
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId]) // One progress per book/user
}

model Author {
  id   Int    @id @default(autoincrement())
  name String

  books Book[]
}
